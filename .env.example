# URL base da rallye-api consumida pelo frontend
VITE_API_BASE_URL=http://localhost:8080

# --- Login social (BEAC-1809/1816) ---
# URL do projeto Supabase, usada apenas para construir a URL pública de
# autorização OAuth (redirect do navegador ao provider). Nenhum token/segredo
# trafega aqui — a troca de código por sessão acontece no backend
# (POST /auth/oauth/callback, BEAC-1815), nunca no frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
