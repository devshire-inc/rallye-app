# URL base da rallye-api consumida pelo frontend
VITE_API_BASE_URL=http://localhost:8080

# --- Login social (BEAC-1809/1816) ---
# Nenhuma variável própria de Supabase é necessária aqui: desde a correção de
# arquitetura de BEAC-1815, o frontend nunca fala com o Supabase (nem para o
# redirect inicial) — o botão social apenas navega para
# {VITE_API_BASE_URL}/auth/oauth/authorize?provider=google, e o backend cuida
# do resto (PKCE, redirect ao Supabase, troca de código, sessão).

# --- Push notifications / FCM (BEAC-1723, Épico 10) ---
# Config PÚBLICA do projeto Firebase (Web app) — não é segredo, é a mesma
# config client-side embutida em qualquer app Firebase (protegida por regras
# de segurança do lado do servidor, não por sigilo). Sem essas variáveis
# setadas, src/lib/push.ts falha ao iniciar o SDK e o erro é só logado
# (setupPushNotifications nunca lança) — dev/CI sem Firebase configurado não
# quebra, só não registra push de verdade. Dashboard do Firebase -> Project
# Settings -> General -> "Your apps" -> Web app -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VAPID key (Web Push certificate) — Dashboard do Firebase -> Project
# Settings -> Cloud Messaging -> Web configuration -> "Web Push certificates".
# Só usada pelo fluxo Web (getToken); não se aplica ao fluxo nativo
# (@capacitor/push-notifications fala direto com FCM/APNs via o app nativo).
VITE_FIREBASE_VAPID_KEY=
